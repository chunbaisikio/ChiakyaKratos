# Canonical address for article URLs, RSS and sitemap.
SITE_URL=http://localhost:3001
HOST=127.0.0.1
PORT=3001
COOKIE_SECURE=false
# If a development port is occupied, change it here. Proxies follow these values.
# DEV_PORT=4321
# DEV_WORKSPACE_PORT=5173
# DEV_SITE_ADMIN_PORT=5174
# DEV_FF14_ADMIN_PORT=5175
# Optional absolute path to an existing database. Keep its .auth-key beside it.
# DB_PATH=
# Optional read-only directory containing legacy public assets and URLs.
# LEGACY_BLOG_DIST_PATH=
