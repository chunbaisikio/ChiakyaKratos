---
import { type Post, postUrl, dateLabel, excerpt, isFF14 } from "../lib/posts";
interface Props {
  post: Post;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
const category = post.data.categories[0] || "日常记录";
const cover = post.data.cover || (featured ? "/assets/Lolita.webp" : undefined);
---

<article class:list={["post-card", { "post-featured": featured }]}>
  {cover ? (
    <a
      href={postUrl(post)}
      class="post-card-image"
      tabindex="-1"
      aria-hidden="true"
    >
      <img src={cover} alt="" loading="lazy" width="900" height="500" />
    </a>
  ) : (
    <a
      href={postUrl(post)}
      class:list={[
        "post-card-image",
        "post-art",
        { "post-art-ff14": isFF14(post) },
      ]}
      tabindex="-1"
      aria-hidden="true"
    >
      <svg
        viewBox="0 0 48 48"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path
          d={
            isFF14(post)
              ? "M12 7l29 29-5 5L7 12V7h5ZM25 16l11-9h5v5l-9 11M16 32l-9 9M12 28l8 8"
              : "M12 6h19l7 7v29H12ZM30 6v9h8M18 23h14M18 29h14M18 35h10"
          }
        />
      </svg>
      <span>{category}</span>
    </a>
  )}
  <div class="post-card-body">
    <div class="post-meta">
      <span class="category-label">{category}</span>
      <time datetime={post.data.date.toISOString()}>
        {dateLabel(post.data.date)}
      </time>
    </div>
    <h3>
      <a href={postUrl(post)}>{post.data.title}</a>
    </h3>
    <p>{excerpt(post, featured ? 140 : 85)}</p>
    <a class="text-link" href={postUrl(post)}>
      继续阅读 <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
