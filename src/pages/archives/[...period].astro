---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { allPosts, postUrl, dateLabel } from "../../lib/posts";
export async function getStaticPaths() {
  const posts = await allPosts();
  const periods = [
    ...new Set(
      posts.flatMap((post) => {
        const period = new Intl.DateTimeFormat("en-CA", {
          timeZone: "Asia/Shanghai",
          year: "numeric",
          month: "2-digit",
        })
          .format(post.data.date)
          .replace("-", "/");
        return [period.split("/")[0], period];
      }),
    ),
  ];
  return periods.map((period) => ({
    params: { period },
    props: {
      posts: posts.filter((post) =>
        new Intl.DateTimeFormat("en-CA", {
          timeZone: "Asia/Shanghai",
          year: "numeric",
          month: "2-digit",
        })
          .format(post.data.date)
          .replace("-", "/")
          .startsWith(period),
      ),
    },
  }));
}
const { posts } = Astro.props;
const title = `${Astro.params.period?.replace("/", " 年 ")}${Astro.params.period?.includes("/") ? " 月" : " 年"}归档`;
---

<SiteLayout title={title}>
  <section class="page-intro">
    <p class="eyebrow">THE ARCHIVE</p>
    <h1>{title}</h1>
    <a class="text-link" href="/archives/">
      ← 完整归档
    </a>
  </section>
  <section class="archive-section">
    {posts.map((post) => (
      <a class="archive-row" href={postUrl(post)}>
        <time>{dateLabel(post.data.date)}</time>
        <span>{post.data.title}</span>
        <span aria-hidden="true">↗</span>
      </a>
    ))}
  </section>
</SiteLayout>
