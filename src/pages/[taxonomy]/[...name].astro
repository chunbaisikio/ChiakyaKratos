---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { allPosts } from "../../lib/posts";
export async function getStaticPaths() {
  const posts = await allPosts();
  return (["tags", "categories"] as const).flatMap((taxonomy) =>
    [...new Set(posts.flatMap((post) => post.data[taxonomy]))].map((name) => ({
      params: { taxonomy, name },
      props: {
        name,
        posts: posts.filter((post) => post.data[taxonomy].includes(name)),
        taxonomy,
      },
    })),
  );
}
const { name, posts, taxonomy } = Astro.props;
---

<SiteLayout title={name}>
  <section class="page-intro">
    <p class="eyebrow">{taxonomy === "tags" ? "TAG" : "CATEGORY"}</p>
    <h1>{name}</h1>
    <p>{posts.length} 篇相关记录。</p>
    <a class="text-link" href="/blog/">
      ← 查看全部文章
    </a>
  </section>
  <section class="post-grid blog-grid">
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </section>
</SiteLayout>
