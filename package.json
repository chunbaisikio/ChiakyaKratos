{
  "name": "chiakya-home",
  "version": "1.0.0",
  "private": true,
  "description": "Chiakya 的个人博客、相册、游戏名片与 FF14 协作复盘",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "postinstall": "node tools/ensure-native.mjs",
    "dev": "node tools/dev.mjs",
    "build": "node tools/build-site.mjs",
    "start": "node tools/serve.mjs",
    "preview": "node tools/astro.mjs preview --host 127.0.0.1",
    "check": "node node_modules/typescript/bin/tsc -b apps/console/tsconfig.json && node tools/astro.mjs check",
    "lint": "eslint apps/console",
    "test": "npm run test:site && npm run test:ui && npm run test:api",
    "test:site": "node --test tests/*.test.mjs",
    "test:ui": "node tools/console.mjs test",
    "test:api": "node test/workflow_api_check.mjs && node test/migration_check.mjs && node test/album_api_check.mjs && node test/game_profiles_api_check.mjs && node test/admin_boundaries_api_check.mjs",
    "test:browser": "node tests/browser-check.mjs",
    "verify": "npm run check && npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@astrojs/sitemap": "3.7.4",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "canvas-confetti": "1.9.4",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "lucide-react": "1.17.0",
    "marked": "18.0.14",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.16.0",
    "recharts": "3.8.1",
    "sanitize-html": "2.18.0",
    "sharp": "0.35.5",
    "sqlite3": "6.0.1",
    "tailwindcss": "4.3.3",
    "yaml": "2.9.1",
    "zod": "4.6.5",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "24.19.1",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.4.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0",
    "vite": "8.3.2",
    "vitest": "4.1.7"
  }
}
